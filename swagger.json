{
  "swagger": "2.0",
  "info": {
    "title": "Event Management API",
    "description": "API for managing events and venues",
    "version": "1.0.0"
  },
  "host": "cse341-project3-kyws.onrender.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Check login status",
        "description": "Returns the current GitHub authentication status.",
        "responses": {
          "200": {
            "description": "Login status returned successfully."
          }
        }
      }
    },
    "/login": {
      "get": {
        "summary": "Login with GitHub",
        "description": "Redirects the user to GitHub for authentication.",
        "responses": {
          "302": {
            "description": "Redirect to GitHub."
          }
        }
      }
    },

    "/github/callback": {
      "get": {
        "summary": "GitHub authentication callback",
        "description": "Handles the callback from GitHub after authentication.",
        "responses": {
          "302": {
            "description": "Redirect after authentication."
          }
        }
      }
    },

    "/logout": {
      "get": {
        "summary": "Logout",
        "description": "Logs the authenticated user out and destroys the session.",
        "responses": {
          "302": {
            "description": "Redirect after logout."
          }
        }
      }
    },

    "/events": {
      "get": {
        "summary": "Get all events",
        "description": "Returns a list of all events.",
        "tags": [
          "Events"
        ],
        "responses": {
          "200": {
            "description": "Events retrieved successfully."
          },
          "500": {
            "description": "Server error."
          }
        }
      },

      "post": {
        "summary": "Create an event",
        "description": "Creates a new event. Authentication is required.",
        "tags": [
          "Events"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Event"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Event created successfully."
          },
          "400": {
            "description": "All fields are required."
          },
          "401": {
            "description": "Authentication required."
          },
          "500": {
            "description": "Server error."
          }
        }
      }
    },

    "/events/{id}": {
      "get": {
        "summary": "Get a single event",
        "description": "Returns one event by its MongoDB ID.",
        "tags": [
          "Events"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Event retrieved successfully."
          },
          "400": {
            "description": "Invalid event ID."
          },
          "404": {
            "description": "Event not found."
          },
          "500": {
            "description": "Server error."
          }
        }
      },

      "put": {
        "summary": "Update an event",
        "description": "Updates an existing event. Authentication is required.",
        "tags": [
          "Events"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Event"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Event updated successfully."
          },
          "400": {
            "description": "Invalid event ID or missing fields."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Event not found."
          },
          "500": {
            "description": "Server error."
          }
        }
      },

      "delete": {
        "summary": "Delete an event",
        "description": "Deletes an event by its MongoDB ID. Authentication is required.",
        "tags": [
          "Events"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "204": {
            "description": "Event deleted successfully."
          },
          "400": {
            "description": "Invalid event ID."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Event not found."
          },
          "500": {
            "description": "Server error."
          }
        }
      }
    },

    "/venues": {
      "get": {
        "summary": "Get all venues",
        "description": "Returns a list of all venues.",
        "tags": [
          "Venues"
        ],
        "responses": {
          "200": {
            "description": "Venues retrieved successfully."
          },
          "500": {
            "description": "Server error."
          }
        }
      },

      "post": {
        "summary": "Create a venue",
        "description": "Creates a new venue. Authentication is required.",
        "tags": [
          "Venues"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Venue"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Venue created successfully."
          },
          "400": {
            "description": "All fields are required."
          },
          "401": {
            "description": "Authentication required."
          },
          "500": {
            "description": "Server error."
          }
        }
      }
    },

    "/venues/{id}": {
      "get": {
        "summary": "Get a single venue",
        "description": "Returns one venue by its MongoDB ID.",
        "tags": [
          "Venues"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Venue retrieved successfully."
          },
          "400": {
            "description": "Invalid venue ID."
          },
          "404": {
            "description": "Venue not found."
          },
          "500": {
            "description": "Server error."
          }
        }
      },

      "put": {
        "summary": "Update a venue",
        "description": "Updates an existing venue. Authentication is required.",
        "tags": [
          "Venues"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Venue"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Venue updated successfully."
          },
          "400": {
            "description": "Invalid venue ID or missing fields."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Venue not found."
          },
          "500": {
            "description": "Server error."
          }
        }
      },

      "delete": {
        "summary": "Delete a venue",
        "description": "Deletes a venue by its MongoDB ID. Authentication is required.",
        "tags": [
          "Venues"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "204": {
            "description": "Venue deleted successfully."
          },
          "400": {
            "description": "Invalid venue ID."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Venue not found."
          },
          "500": {
            "description": "Server error."
          }
        }
      }
    }
  },

  "definitions": {
    "Event": {
      "type": "object",
      "required": [
        "title",
        "description",
        "date",
        "startTime",
        "endTime",
        "organizer",
        "ticketPrice"
      ],
      "properties": {
        "title": {
          "type": "string",
          "example": "Tech Conference 2026"
        },
        "description": {
          "type": "string",
          "example": "Annual technology conference."
        },
        "date": {
          "type": "string",
          "example": "2026-10-15"
        },
        "startTime": {
          "type": "string",
          "example": "09:00 AM"
        },
        "endTime": {
          "type": "string",
          "example": "05:00 PM"
        },
        "organizer": {
          "type": "string",
          "example": "Tech Hub Zimbabwe"
        },
        "ticketPrice": {
          "type": "number",
          "example": 50
        }
      }
    },

    "Venue": {
      "type": "object",
      "required": [
        "name",
        "address",
        "city",
        "country",
        "capacity",
        "contactEmail",
        "contactPhone"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "Harare International Conference Centre"
        },
        "address": {
          "type": "string",
          "example": "Samora Machel Avenue"
        },
        "city": {
          "type": "string",
          "example": "Harare"
        },
        "country": {
          "type": "string",
          "example": "Zimbabwe"
        },
        "capacity": {
          "type": "integer",
          "example": 4500
        },
        "contactEmail": {
          "type": "string",
          "example": "info@hicc.co.zw"
        },
        "contactPhone": {
          "type": "string",
          "example": "+263771234567"
        }
      }
    }
  }
}

