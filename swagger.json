  "definitions": {
    "Event": {
      "type": "object",
      "required": [
        "title",
        "description",
        "date",
        "startTime",
        "endTime",
        "organizer",
        "ticketPrice"
      ],
      "properties": {
        "title": {
          "type": "string",
          "example": "Tech Conference 2026"
        },
        "description": {
          "type": "string",
          "example": "Annual technology conference."
        },
        "date": {
          "type": "string",
          "example": "2026-10-15"
        },
        "startTime": {
          "type": "string",
          "example": "09:00 AM"
        },
        "endTime": {
          "type": "string",
          "example": "05:00 PM"
        },
        "organizer": {
          "type": "string",
          "example": "Tech Hub Zimbabwe"
        },
        "ticketPrice": {
          "type": "number",
          "example": 50
        }
      }
    },

    "Venue": {
      "type": "object",
      "required": [
        "name",
        "address",
        "city",
        "country",
        "capacity",
        "contactEmail",
        "contactPhone"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "Harare International Conference Centre"
        },
        "address": {
          "type": "string",
          "example": "Samora Machel Avenue"
        },
        "city": {
          "type": "string",
          "example": "Harare"
        },
        "country": {
          "type": "string",
          "example": "Zimbabwe"
        },
        "capacity": {
          "type": "integer",
          "example": 4500
        },
        "contactEmail": {
          "type": "string",
          "example": "info@hicc.co.zw"
        },
        "contactPhone": {
          "type": "string",
          "example": "+263771234567"
        }
      }
    },

    "Attendee": {
      "type": "object",
      "required": [
        "firstName",
        "lastName",
        "email",
        "phone",
        "eventId",
        "registrationDate",
        "ticketType",
        "status"
      ],
      "properties": {
        "firstName": {
          "type": "string",
          "example": "John"
        },
        "lastName": {
          "type": "string",
          "example": "Moyo"
        },
        "email": {
          "type": "string",
          "format": "email",
          "example": "john@example.com"
        },
        "phone": {
          "type": "string",
          "example": "+263771234567"
        },
        "eventId": {
          "type": "string",
          "example": "6a7981cffb77f5b929943463"
        },
        "registrationDate": {
          "type": "string",
          "example": "2026-08-11"
        },
        "ticketType": {
          "type": "string",
          "example": "Standard"
        },
        "status": {
          "type": "string",
          "example": "Registered"
        }
      }
    },

    "Host": {
      "type": "object",
      "required": [
        "name",
        "organization",
        "email",
        "phone",
        "address",
        "city",
        "country"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "Tech Hub Zimbabwe"
        },
        "organization": {
          "type": "string",
          "example": "Zimbabwe Technology Association"
        },
        "email": {
          "type": "string",
          "format": "email",
          "example": "info@techhub.co.zw"
        },
        "phone": {
          "type": "string",
          "example": "+263771234567"
        },
        "address": {
          "type": "string",
          "example": "Samora Machel Avenue"
        },
        "city": {
          "type": "string",
          "example": "Harare"
        },
        "country": {
          "type": "string",
          "example": "Zimbabwe"
        }
      }
    }
  }
